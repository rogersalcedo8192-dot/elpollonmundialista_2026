# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Railway / PostgreSQL
# Copia aqui la URL del plugin PostgreSQL de Railway cuando trabajes local.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Railway asigna PORT automaticamente. Localmente puedes usar 3001 si 3000 esta ocupado.
PORT=3000

# APP_MODE:
# PAID mantiene la pasarela activa y bloqueo por pago.
# FREE permite registrar/pronosticar sin pago, sin eliminar la pasarela.
APP_MODE="PAID"

# PAYMENT_PROVIDER:
# wompi usa Web Checkout de Wompi.
# stripe mantiene el flujo Stripe existente como respaldo.
PAYMENT_PROVIDER="wompi"

# Wompi
WOMPI_ENV="sandbox"
WOMPI_PUBLIC_KEY="pub_test_xxx"
WOMPI_PRIVATE_KEY="prv_test_xxx"
WOMPI_INTEGRITY_SECRET="test_integrity_xxx"
WOMPI_CURRENCY="COP"
# Wompi requiere el monto en centavos de la moneda: 20000 COP => 2000000.
WOMPI_AMOUNT_IN_CENTS="2000000"

# Aporte inicial opcional del administrador a la bolsa neta de premios, en COP.
PRIZE_SEED_COP="0"

# Stripe opcional si PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY="sk_test_xxx"

# Resend: correos transaccionales y alertas importantes.
# Verifica tu dominio en Resend y usa un remitente de ese dominio.
RESEND_API_KEY="re_xxx"
EMAIL_FROM="El Pollon Mundialista <notificaciones@elpollonmundialista.com>"
EMAIL_REPLY_TO="admin@elpollonmundialista.com"

# football-data.org: calendario y resultados del Mundial.
FOOTBALL_DATA_API_TOKEN="tu_token"
FOOTBALL_DATA_COMPETITION="WC"
FOOTBALL_DATA_SEASON="2026"
# Intervalo de sincronizacion automatica. Minimo permitido: 60000 ms.
FOOTBALL_DATA_SYNC_INTERVAL_MS="300000"

# Cloudinary: storage externo para imagenes, videos, PDF y documentos.
CLOUDINARY_CLOUD_NAME="MY_CLOUD_NAME"
CLOUDINARY_API_KEY="MY_API_KEY"
CLOUDINARY_API_SECRET="MY_API_SECRET"
